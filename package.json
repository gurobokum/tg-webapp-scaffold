{
  "name": "gramstack",
  "version": "0.1.0",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "description": "Full-stack starter for Telegram Mini Apps",
  "scripts": {
    "start": "pnpm -F @gramstack/miniapp start",
    "build": "pnpm -F @gramstack/miniapp build",
    "miniapp:dev": "pnpm -F @gramstack/miniapp dev",
    "miniapp:lint": "pnpm -F @gramstack/miniapp lint",
    "miniapp:format:check": "pnpm -F @gramstack/miniapp format:check",
    "miniapp:ts": "pnpm -F @gramstack/miniapp ts",
    "miniapp:test": "pnpm -F @gramstack/miniapp test",
    "backend:format": "cd packages/backend && uv run task format",
    "backend:lint": "cd packages/backend && uv run task lint",
    "backend:mypy": "cd packages/backend && uv run task mypy",
    "backend:generate_openapi": "cd packages/backend && uv run task generate_openapi",
    "sdk:generate_openapi": "pnpm -F @gramstack/sdk generate_openapi && pnpm -F @gramstack/sdk build",
    "generate_openapi": "pnpm backend:generate_openapi && pnpm sdk:generate_openapi",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "Guro Bokum <jiojiajiu@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "@commitlint/cli": "^19.8.0",
    "@commitlint/config-conventional": "^19.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2"
  }
}
